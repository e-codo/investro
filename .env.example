# Скопируйте этот файл в .env.local и заполните. Сам .env.local в git не попадает.
# На Vercel те же переменные задаются в Settings → Environment Variables.

# Случайная строка от 32 символов для подписи сессии.
# Сгенерировать: openssl rand -base64 48
SESSION_SECRET=

# Строка подключения к Postgres.
# Локально: postgres://investro:investro@localhost:5432/investro
# На Vercel её выдаёт база из Storage (Neon).
DATABASE_URL=
